{
  "style": "sketch",
  "ui_font": "../../../app/src/main/res/font/plus_jakarta_sans_regular.ttf",
  "theme": {
    "primary": "#3B5BDB",
    "on_primary": "#FFFFFF",
    "background": "#F7F5F2",
    "surface": "#FFFFFF",
    "text": "#111827",
    "muted": "#6B7280",
    "border": "#E5E7EB",
    "accent": "#F59E0B",
    "danger": "#DC2626",
    "success": "#16A34A",
    "info": "#0D9488",
    "radius": 18,
    "button_radius": 14,
    "selected": "#CCFBF1",
    "on_selected": "#1E3A8A"
  },
  "frames": [
    {
      "id": "home",
      "device": "phone",
      "screen": [
        {
          "type": "text",
          "text": "Toolbox",
          "style": "h1"
        },
        {
          "type": "pill",
          "text": "Offline • Private"
        },
        {
          "type": "button",
          "id": "scan",
          "text": "Scan document",
          "icon": "camera",
          "full": true,
          "pill": true,
          "size": "lg"
        },
        {
          "type": "text",
          "text": "Quick tools",
          "style": "title"
        },
        {
          "type": "grid",
          "id": "tools",
          "cols": 2,
          "style": "compact",
          "items": [
            {
              "title": "Split",
              "sub": "Extract pages",
              "icon": "split"
            },
            {
              "title": "Merge",
              "sub": "Combine PDFs",
              "icon": "merge"
            },
            {
              "title": "Compress",
              "sub": "Hit a size limit",
              "icon": "compress"
            },
            {
              "title": "OCR",
              "sub": "Copy text out",
              "icon": "text"
            }
          ]
        },
        {
          "type": "section",
          "id": "recent",
          "title": "Recent",
          "action": "See all"
        },
        {
          "type": "list",
          "id": "recent_files",
          "style": "cards",
          "trailing": "more",
          "items": [
            {
              "title": "Invoice-March_merged_2.pdf",
              "sub": "Merge · 412 KB · 26 Oct 2026",
              "icon": "pdf"
            },
            {
              "title": "Payslip-Oct_compressed.pdf",
              "sub": "Compress · 1.7 MB · 25 Oct 2026",
              "icon": "pdf"
            }
          ]
        },
        {
          "type": "bottomnav",
          "id": "nav",
          "active": 0,
          "items": [
            {
              "icon": "home",
              "label": "Home"
            },
            {
              "icon": "folder",
              "label": "Files"
            },
            {
              "icon": "build",
              "label": "Tools"
            },
            {
              "icon": "settings",
              "label": "Settings"
            }
          ]
        }
      ],
      "overlays": [
        {
          "type": "fab",
          "id": "fab",
          "icon": "camera",
          "color": "accent"
        }
      ]
    }
  ],
  "steps": [
    {
      "target": "home.scan",
      "text": "Scan paper into a PDF"
    },
    {
      "target": "home.tools",
      "text": "Open a tool in one tap"
    },
    {
      "target": "home.recent.action",
      "text": "See every file you've made"
    },
    {
      "target": "home.nav",
      "text": "Switch between tabs"
    }
  ],
  "notes": [
    {
      "target": "home.fab",
      "text": "Scan from Home or Files"
    }
  ],
  "mascot": {
    "character": "xiaohei",
    "pose": "peek",
    "target": "home.screen",
    "explain": {
      "title": "No account needed",
      "text": "Everything runs on your phone, so there is nothing to sign up for.",
      "shape": "cloud"
    }
  }
}
