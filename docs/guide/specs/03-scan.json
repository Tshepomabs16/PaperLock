{
  "style": "sketch",
  "ui_font": "../../../app/src/main/res/font/plus_jakarta_sans_regular.ttf",
  "theme": {
    "primary": "#3B5BDB",
    "on_primary": "#FFFFFF",
    "background": "#F7F5F2",
    "surface": "#FFFFFF",
    "text": "#111827",
    "muted": "#6B7280",
    "border": "#E5E7EB",
    "accent": "#F59E0B",
    "danger": "#DC2626",
    "success": "#16A34A",
    "info": "#0D9488",
    "radius": 18,
    "button_radius": 14,
    "selected": "#CCFBF1",
    "on_selected": "#1E3A8A"
  },
  "frames": [
    {
      "id": "home",
      "device": "phone",
      "screen": [
        {
          "type": "text",
          "text": "Toolbox",
          "style": "h1"
        },
        {
          "type": "pill",
          "text": "Offline • Private"
        },
        {
          "type": "button",
          "id": "scan",
          "text": "Scan document",
          "icon": "camera",
          "full": true,
          "pill": true,
          "size": "lg"
        },
        {
          "type": "text",
          "text": "Quick tools",
          "style": "title"
        },
        {
          "type": "grid",
          "id": "tools",
          "cols": 2,
          "style": "compact",
          "items": [
            {
              "title": "Split",
              "sub": "Extract pages",
              "icon": "split"
            },
            {
              "title": "Merge",
              "sub": "Combine PDFs",
              "icon": "merge"
            },
            {
              "title": "Compress",
              "sub": "Hit a size limit",
              "icon": "compress"
            },
            {
              "title": "OCR",
              "sub": "Copy text out",
              "icon": "text"
            }
          ]
        },
        {
          "type": "section",
          "id": "recent",
          "title": "Recent",
          "action": "See all"
        },
        {
          "type": "empty",
          "id": "empty",
          "icon": "doc",
          "text": "Your recent files will appear here.",
          "action": "Scan a document",
          "style": "text"
        },
        {
          "type": "bottomnav",
          "id": "nav",
          "active": 0,
          "items": [
            {
              "icon": "home",
              "label": "Home"
            },
            {
              "icon": "folder",
              "label": "Files"
            },
            {
              "icon": "build",
              "label": "Tools"
            },
            {
              "icon": "settings",
              "label": "Settings"
            }
          ]
        }
      ],
      "overlays": [
        {
          "type": "fab",
          "id": "fab",
          "icon": "camera",
          "color": "accent"
        }
      ]
    },
    {
      "id": "intro",
      "device": "phone",
      "screen": [
        {
          "type": "appbar",
          "id": "bar",
          "title": "Scan to PDF",
          "nav": "back"
        },
        {
          "type": "spacer",
          "height": 190
        },
        {
          "type": "text",
          "text": "Photograph pages with your camera or import from your gallery. Everything stays on this device.",
          "align": "center"
        },
        {
          "type": "spacer",
          "height": 12
        },
        {
          "type": "button",
          "id": "start",
          "text": "Start scanning",
          "align": "center",
          "size": "lg"
        }
      ]
    },
    {
      "id": "pages",
      "device": "phone",
      "screen": [
        {
          "type": "appbar",
          "id": "bar",
          "title": "Pages (3)",
          "nav": "back"
        },
        {
          "type": "chips",
          "id": "filter",
          "items": [
            "Original",
            "Grayscale",
            "B&W"
          ],
          "active": "B&W"
        },
        {
          "type": "image",
          "id": "preview",
          "kind": "page",
          "height": 250
        },
        {
          "type": "icons",
          "id": "edit",
          "items": [
            {
              "icon": "rotate-left",
              "label": "Rotate"
            },
            {
              "icon": "trash",
              "label": "Delete page"
            }
          ]
        },
        {
          "type": "thumbs",
          "id": "thumbs",
          "items": 3,
          "selected": 0,
          "add": true,
          "add_icon": "refresh"
        },
        {
          "type": "button",
          "id": "export",
          "text": "Export PDF (3 pages)",
          "full": true,
          "size": "lg"
        }
      ]
    }
  ],
  "steps": [
    {
      "target": "home.scan",
      "text": "Tap \"Scan document\""
    },
    {
      "target": "intro.start",
      "text": "Tap \"Start scanning\" and snap your pages"
    },
    {
      "target": "pages.filter.b-w",
      "text": "Pick \"B&W\" for crisp text"
    },
    {
      "target": "pages.export",
      "text": "Tap \"Export PDF (3 pages)\""
    }
  ],
  "notes": [
    {
      "target": "pages.thumbs.add",
      "text": "Add more pages at any time"
    }
  ],
  "mascot": {
    "character": "xiaohei",
    "pose": "point",
    "target": "pages.export"
  },
  "flow": [
    {
      "from": "home.scan",
      "to": "intro"
    },
    {
      "from": "intro.start",
      "to": "pages",
      "text": "snap pages"
    }
  ]
}
