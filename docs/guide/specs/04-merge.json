{
  "style": "sketch",
  "ui_font": "../../../app/src/main/res/font/plus_jakarta_sans_regular.ttf",
  "theme": {
    "primary": "#3B5BDB",
    "on_primary": "#FFFFFF",
    "background": "#F7F5F2",
    "surface": "#FFFFFF",
    "text": "#111827",
    "muted": "#6B7280",
    "border": "#E5E7EB",
    "accent": "#F59E0B",
    "danger": "#DC2626",
    "success": "#16A34A",
    "info": "#0D9488",
    "radius": 18,
    "button_radius": 14,
    "selected": "#CCFBF1",
    "on_selected": "#1E3A8A"
  },
  "frames": [
    {
      "id": "home",
      "device": "phone",
      "screen": [
        {
          "type": "text",
          "text": "Toolbox",
          "style": "h1"
        },
        {
          "type": "pill",
          "text": "Offline • Private"
        },
        {
          "type": "button",
          "id": "scan",
          "text": "Scan document",
          "icon": "camera",
          "full": true,
          "pill": true,
          "size": "lg"
        },
        {
          "type": "text",
          "text": "Quick tools",
          "style": "title"
        },
        {
          "type": "grid",
          "id": "tools",
          "cols": 2,
          "style": "compact",
          "items": [
            {
              "title": "Split",
              "sub": "Extract pages",
              "icon": "split"
            },
            {
              "title": "Merge",
              "sub": "Combine PDFs",
              "icon": "merge"
            },
            {
              "title": "Compress",
              "sub": "Hit a size limit",
              "icon": "compress"
            },
            {
              "title": "OCR",
              "sub": "Copy text out",
              "icon": "text"
            }
          ]
        },
        {
          "type": "section",
          "id": "recent",
          "title": "Recent",
          "action": "See all"
        },
        {
          "type": "list",
          "id": "recent_files",
          "style": "cards",
          "trailing": "more",
          "items": [
            {
              "title": "Invoice-March_merged_2.pdf",
              "sub": "Merge · 412 KB · 26 Oct 2026",
              "icon": "pdf"
            },
            {
              "title": "Payslip-Oct_compressed.pdf",
              "sub": "Compress · 1.7 MB · 25 Oct 2026",
              "icon": "pdf"
            }
          ]
        },
        {
          "type": "bottomnav",
          "id": "nav",
          "active": 0,
          "items": [
            {
              "icon": "home",
              "label": "Home"
            },
            {
              "icon": "folder",
              "label": "Files"
            },
            {
              "icon": "build",
              "label": "Tools"
            },
            {
              "icon": "settings",
              "label": "Settings"
            }
          ]
        }
      ],
      "overlays": [
        {
          "type": "fab",
          "id": "fab",
          "icon": "camera",
          "color": "accent"
        }
      ]
    },
    {
      "id": "empty",
      "device": "phone",
      "screen": [
        {
          "type": "appbar",
          "id": "bar",
          "title": "Merge",
          "nav": "back"
        },
        {
          "type": "card",
          "id": "what",
          "label": "What this does",
          "body": "Join several PDFs into one, in the order you set below."
        },
        {
          "type": "button",
          "id": "choose",
          "text": "Choose PDFs",
          "full": true,
          "size": "lg"
        }
      ]
    },
    {
      "id": "list",
      "device": "phone",
      "screen": [
        {
          "type": "appbar",
          "id": "bar",
          "title": "Merge",
          "nav": "back"
        },
        {
          "type": "card",
          "id": "what",
          "label": "What this does",
          "body": "Join several PDFs into one, in the order you set below."
        },
        {
          "type": "text",
          "text": "2 files — output order",
          "style": "label"
        },
        {
          "type": "list",
          "id": "files",
          "style": "cards",
          "numbered": "text",
          "trailing": [
            "chevron-up",
            "chevron-down",
            "close"
          ],
          "items": [
            {
              "title": "Invoice-March.pdf",
              "disabled_icons": [
                0
              ]
            },
            {
              "title": "Receipts.pdf",
              "disabled_icons": [
                1
              ]
            }
          ]
        },
        {
          "type": "button",
          "id": "go",
          "text": "Merge 2 files",
          "full": true,
          "size": "lg"
        },
        {
          "type": "button",
          "id": "add",
          "text": "Add more",
          "style": "secondary",
          "full": true,
          "size": "lg"
        }
      ]
    }
  ],
  "steps": [
    {
      "target": "home.tools.merge",
      "text": "Tap \"Merge\""
    },
    {
      "target": "empty.choose",
      "text": "Tap \"Choose PDFs\" and pick your files"
    },
    {
      "target": "list.files.1.chevron-up",
      "text": "Use the arrows to set the order"
    },
    {
      "target": "list.go",
      "text": "Tap \"Merge 2 files\""
    }
  ],
  "notes": [
    {
      "target": "list.add",
      "text": "Picked only one? Tap \"Add more\""
    }
  ],
  "mascot": {
    "character": "xiaohei",
    "pose": "point",
    "target": "list.go"
  }
}
